{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "where-were-we",
  "version": "0.4.0",
  "identifier": "dev.ganggangstone.where-were-we",
  "build": {
    "frontendDist": "frontend",
    "beforeBuildCommand": "python3 scripts/prepare-runtime.py",
    "beforeDevCommand": {
      "script": "python3 scripts/prepare-runtime.py",
      "wait": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "where were we",
        "width": 1480,
        "height": 940,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
